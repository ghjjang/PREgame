{
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "globals": {
    "SkillManager": "readonly"
  },
  "rules": {
    "no-redeclare": "error",
    "no-undef": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-func-assign": "error",
    "no-unused-vars": ["warn", { "vars": "all", "args": "after-used", "ignoreRestSiblings": true }],
    "no-unreachable": "error",
    "eqeqeq": ["warn", "smart"],
    "no-constant-condition": ["warn", { "checkLoops": false }]
  }
}
